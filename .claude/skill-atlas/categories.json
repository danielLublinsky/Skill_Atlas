  "taxonomy": [
    {
      "description": "figuring out what should be built and pressure-testing the idea, before any plan is committed to writing",
      "name": "discovery-and-brainstorming"
    },
    {
      "description": "writing decided work down as plans, specs or tickets and moving those items through a tracker; deciding what to build belongs to discovery",
      "name": "planning-and-tracking"
    },
    {
      "description": "answering an open question by investigating what already exists \u2014 an unfamiliar codebase or outside sources \u2014 without changing anything",
      "name": "research-and-codebase-understanding"
    },
    {
      "description": "deciding the shape of the thing being built \u2014 module boundaries, shared domain vocabulary, and how an interface should look and feel \u2014 apart from writing the change itself",
      "name": "design-and-architecture"
    },
    {
      "description": "carrying out work that has already been decided and written down, including splitting it across concurrent agents",
      "name": "implementation"
    },
    {
      "description": "proving behaviour is correct \u2014 driving the work from tests, or gathering evidence before claiming it is done",
      "name": "testing-and-verification"
    },
    {
      "description": "tracking down the cause of a failure, regression or unexpected behaviour that is already happening; proving correctness in advance belongs to testing",
      "name": "debugging"
    },
    {
      "description": "judging code that is already written against standards and intent, and handling the feedback that comes back",
      "name": "code-review"
    },
    {
      "description": "moving changes through branches, isolated workspaces and conflicts, and landing finished work",
      "name": "version-control"
    },
    {
      "description": "writing and improving the instructions agents read \u2014 new capabilities, prompts, and agent-facing project docs",
      "name": "agent-authoring"
    },
    {
      "description": "configuring the environment the work happens in and routing to whichever already-installed capability fits the task; authoring new ones belongs to agent authoring",
      "name": "tooling-and-environment-setup"
    },
    {
      "description": "getting understanding across to a person or a later agent \u2014 teaching, passing on context, re-pitching, or walking someone through steps only they can perform",
