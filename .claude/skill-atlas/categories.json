  "taxonomy": [
    {
      "description": "Deciding what to build and whether it is the right shape \u2014 exploring intent, stress-testing an idea or decision by interrogation, modeling the domain, and sketching throwaway prototypes; this is the phase before anything is written down as steps, where planning-and-specs takes over.",
      "name": "design-discovery"
    },
    {
      "description": "Turning an agreed idea into a written plan, spec, ticket set or roadmap that someone else can execute, and triaging incoming work items; for laying out scope and sequence, where design-discovery is for questioning the idea itself.",
      "name": "planning-and-specs"
    },
    {
      "description": "Writing and reshaping working code \u2014 executing a plan, building the feature, refactoring for clarity or deeper module boundaries, and shepherding the finished branch through conflicts and merge; for changing code, where code-review-and-security is for judging code that already exists.",
      "name": "implementation-and-code-change"
    },
    {
      "description": "Finding out why something is broken, throwing, failing, hanging or slow \u2014 reproducing it and driving to root cause; for explaining a failure, where testing-and-verification is for writing and running the checks that catch failures.",
      "name": "debugging"
    },
    {
      "description": "Writing and running tests, driving features test-first, and proving work actually works before calling it done; when the question is why a test fails rather than how to test, that is debugging.",
      "name": "testing-and-verification"
    },
    {
      "description": "Judging code that already exists \u2014 correctness, standards, spec conformance, simplification and security risk \u2014 and handling the feedback that comes back; for evaluating a change, where implementation-and-code-change is for making one.",
      "name": "code-review-and-security"
    },
    {
      "description": "Investigating a question against real sources and writing up what is true \u2014 research notes, architecture and codebase explanations, specs of record, handoffs, teaching material, and the instruction files that guide future work.",
      "name": "research-and-documentation"
    },
    {
      "description": "How something looks and reads on a screen \u2014 aesthetic direction, typography, charts and data visualization, diagrams, and published web pages, including the runtime behavior those pages need.",
      "name": "visual-and-ui-design"
    },
    {
      "description": "Building things that run on language models \u2014 authoring prompts and agent-facing instructions, orchestrating parallel or delegated agents, and choosing and calling model APIs from your own code.",
      "name": "agent-and-prompt-engineering"
    },
    {
      "description": "Configuring and extending the coding-agent harness itself \u2014 settings, hooks, permissions, keybindings, authoring and cataloging skills, finding the right skill, and scheduled or recurring runs.",
      "name": "claude-code-configuration"
    },
    {
      "description": "Generating images, video, audio and conversational avatars through the Runway API, and wiring those calls, keys and uploads into an application.",
      "name": "runway-media-generation"
    },
    {
      "description": "Customizing someone else's platform on its own terms \u2014 storefront themes, enterprise design-system theming, and desktop or window-manager configuration \u2014 where the vendor's conventions govern rather than general web, UI or system practice.",
      "name": "vendor-locked-platforms"
    }
  ],
  "taxonomy_approved_at": "2026-08-11",
  "version": 1
}
